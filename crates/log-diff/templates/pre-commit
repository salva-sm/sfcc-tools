# log-diff: paste into .githooks/pre-commit. Only exit status 1 (something
# pending) blocks the commit; an unreachable sandbox, no dw.json or no log-diff
# let it through. `log-diff ack` clears what was dealt with.
if command -v log-diff >/dev/null 2>&1; then
  log_diff_status=0
  log-diff check --fail-on-new --no-desktop || log_diff_status=$?
  if [ "$log_diff_status" -eq 1 ]; then
    exit 1
  fi
fi
