// Copy into the SFCC project as .zed/tasks.json; start it with
// "task: spawn" -> "log-diff: watch".
[
  {
    "label": "log-diff: watch",
    "command": "log-diff",
    "args": ["watch"],
    "env": {
      "LOG_DIFF_SHARED": "https://raw.githubusercontent.com/<owner>/sfcc-log-ledger/main/ledger.json"
    },
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "no_focus",
    "hide": "never"
  }
]
