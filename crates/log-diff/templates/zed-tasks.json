// Copy into the SFCC project as .zed/tasks.json; start it with
// "task: spawn" -> "log-diff: watch". The team's ledger comes from LOG_DIFF_SHARED in your
// user environment (setx on Windows), so every terminal and editor sees the same one.
[
  {
    "label": "log-diff: watch",
    "command": "log-diff",
    "args": ["watch"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "no_focus",
    "hide": "never"
  }
]
