{
  // Copy into the SFCC project as .vscode/tasks.json (or merge the task in).
  // Allow automatic tasks when VS Code asks, or later via "Tasks: Manage Automatic Tasks".
  "version": "2.0.0",
  "tasks": [
    {
      "label": "sfcc-upload: watch",
      "type": "process",
      "command": "sfcc-upload",
      "args": ["watch", "--problems"],
      "isBackground": true,
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "never", "panel": "dedicated", "echo": false },
      "problemMatcher": {
        "owner": "sfcc-upload",
        "source": "sfcc-upload",
        "fileLocation": "absolute",
        "severity": "error",
        "pattern": {
          "regexp": "^(.+):(\\d+): error: (.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        },
        // Each batch clears the last one's problems: a failure stays until an upload works.
        "background": {
          "activeBegin": true,
          "beginsPattern": "^sfcc-upload: (uploading|retrying)",
          "endsPattern": "^sfcc-upload: (synced|failed)$"
        }
      }
    }
  ]
}
