{
  // Copy into the SFCC project as .vscode/tasks.json (or merge the task in).
  // Allow automatic tasks when VS Code asks, or later via "Tasks: Manage Automatic Tasks".
  "version": "2.0.0",
  "tasks": [
    {
      "label": "log-diff: watch",
      "type": "process",
      "command": "log-diff",
      "args": ["watch", "--problems"],
      "options": {
        "env": {
          // A private repository also needs GITHUB_TOKEN (or LOG_DIFF_TOKEN)
          // in your own environment - never in this file.
          "LOG_DIFF_SHARED": "https://raw.githubusercontent.com/<owner>/sfcc-log-ledger/main/ledger.json"
        }
      },
      "isBackground": true,
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "never", "panel": "dedicated", "echo": false },
      "problemMatcher": {
        "owner": "log-diff",
        "source": "sfcc log",
        "fileLocation": "absolute",
        "severity": "error",
        "pattern": {
          "regexp": "^(.+):(\d+): error: (.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        },
        // Every pending signature is listed between these lines, so Problems shows the whole set.
        "background": {
          "activeBegin": "^log-diff: checking ",
          "activeEnd": "^log-diff: (up to date|\d+ pending|\d+ new)"
        }
      }
    }
  ]
}
