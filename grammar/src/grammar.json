        }
      ]
    },
    "_tag_content": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "attribute"
        },
        {
          "type": "SYMBOL",
          "name": "isml_expression"
        },
        {
          "type": "SYMBOL",
